[Unit]
Description=QiuBot QQ composition model refresh
After=local-fs.target
ConditionPathExists=/opt/qiubot/data/bazaar_runs.db

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/qiubot
EnvironmentFile=-/opt/qiubot/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/qiubot/venv/bin/python /opt/qiubot/tools/refresh_comp_families.py
Nice=10
CPUQuota=100%
MemoryHigh=320M
MemoryMax=384M
TimeoutStartSec=20min
